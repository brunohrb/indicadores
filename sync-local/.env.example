# Copie este arquivo para .env e preencha as credenciais
# O arquivo .env NUNCA deve ser commitado no git

# URL base do IXC (sem barra no final)
IXC_URL=https://ixcsoft.texnet.net.br

# Token do IXC no formato id:token (gerado em Configurações > Usuários > Tokens API)
IXC_TOKEN=

# URL do Supabase (ex: https://xxxxxxxxxxx.supabase.co)
SB_URL=

# Chave anon do Supabase (em Project Settings > API > anon public)
SB_KEY=
